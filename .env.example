# Optional backend settings. All values below are the defaults; none are required to run the prototype.
# The backend reads these from process environment variables (it does not load a .env file automatically).
# Set them in your shell before starting the backend if you want to override a default.

# SQLite database location (created and seeded automatically on first start)
WALLET_DATABASE_URL=sqlite:///./wallet.db

# Enables demo fault-injection endpoints (/api/v1/demo/*) used by the "Demo controls" panel.
# Set to false to remove them.
WALLET_DEMO_MODE=true

# Quote validity in seconds
WALLET_QUOTE_TTL_SECONDS=30

# Demo credential for the internal operations API (/internal/v1/*). Not a real secret.
WALLET_OPS_TOKEN=demo-ops-token
